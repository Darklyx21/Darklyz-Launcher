<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/fragment_menu_main" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/darklyz_screen_background" android:clipToPadding="false">

    <!-- Barra lateral estrecha: conserva los IDs que MainMenuFragment conecta. -->
    <LinearLayout android:id="@+id/darklyz_side_nav" android:layout_width="56dp" android:layout_height="0dp" android:layout_marginStart="4dp" android:layout_marginTop="4dp" android:layout_marginBottom="4dp" android:orientation="vertical" android:gravity="center_horizontal" android:padding="4dp" android:background="@drawable/menu_background" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent">
        <ImageView android:id="@+id/darklyz_sidebar_logo" android:layout_width="34dp" android:layout_height="34dp" android:layout_marginTop="4dp" android:layout_marginBottom="8dp" android:contentDescription="Darklyz Launcher" android:src="@drawable/ic_darklyz_logo" android:scaleType="fitCenter" />
        <com.kdt.mcgui.LauncherMenuButton android:id="@+id/news_button" style="@style/LauncherMenuButton.Universal" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginBottom="5dp" android:background="@drawable/darklyz_icon_button" android:contentDescription="Noticias" android:drawableTop="@drawable/ic_menu_news" android:drawablePadding="0dp" android:gravity="center" android:minWidth="0dp" android:minHeight="0dp" android:padding="8dp" android:text=""  android:textAllCaps="false" android:stateListAnimator="@animator/darklyz_button_state" android:elevation="2dp"/>
        <com.kdt.mcgui.LauncherMenuButton android:id="@+id/discord_button" style="@style/LauncherMenuButton.Universal" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginBottom="5dp" android:background="@drawable/darklyz_icon_button" android:contentDescription="Discord" android:drawableTop="@drawable/ic_discord" android:drawablePadding="0dp" android:gravity="center" android:minWidth="0dp" android:minHeight="0dp" android:padding="8dp" android:text=""  android:textAllCaps="false" android:stateListAnimator="@animator/darklyz_button_state" android:elevation="2dp"/>
        <View android:layout_width="26dp" android:layout_height="1dp" android:layout_marginTop="2dp" android:layout_marginBottom="7dp" android:background="@color/darklyz_border" />
        <com.kdt.mcgui.LauncherMenuButton android:id="@+id/custom_control_button" style="@style/LauncherMenuButton.Universal" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginBottom="5dp" android:background="@drawable/darklyz_icon_button" android:contentDescription="Controles" android:drawableTop="@drawable/ic_menu_custom_controls" android:drawablePadding="0dp" android:gravity="center" android:minWidth="0dp" android:minHeight="0dp" android:padding="8dp" android:text=""  android:textAllCaps="false" android:stateListAnimator="@animator/darklyz_button_state" android:elevation="2dp"/>
        <com.kdt.mcgui.LauncherMenuButton android:id="@+id/install_jar_button" style="@style/LauncherMenuButton.Universal" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginBottom="5dp" android:background="@drawable/darklyz_icon_button" android:contentDescription="Instalar archivo JAR" android:drawableTop="@drawable/ic_menu_install_jar" android:drawablePadding="0dp" android:gravity="center" android:minWidth="0dp" android:minHeight="0dp" android:padding="8dp" android:text=""  android:textAllCaps="false" android:stateListAnimator="@animator/darklyz_button_state" android:elevation="2dp"/>
        <com.kdt.mcgui.LauncherMenuButton android:id="@+id/share_logs_button" style="@style/LauncherMenuButton.Universal" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginBottom="5dp" android:background="@drawable/darklyz_icon_button" android:contentDescription="Compartir registros" android:drawableTop="@android:drawable/ic_menu_share" android:drawablePadding="0dp" android:gravity="center" android:minWidth="0dp" android:minHeight="0dp" android:padding="8dp" android:text=""  android:textAllCaps="false" android:stateListAnimator="@animator/darklyz_button_state" android:elevation="2dp"/>
        <com.kdt.mcgui.LauncherMenuButton android:id="@+id/open_files_button" style="@style/LauncherMenuButton.Universal" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginBottom="5dp" android:background="@drawable/darklyz_icon_button" android:contentDescription="Abrir archivos" android:drawableTop="@drawable/ic_folder" android:drawablePadding="0dp" android:gravity="center" android:minWidth="0dp" android:minHeight="0dp" android:padding="8dp" android:text=""  android:textAllCaps="false" android:stateListAnimator="@animator/darklyz_button_state" android:elevation="2dp"/>
        <View android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="5dp" android:text="DLZ" android:textColor="@color/darklyz_cyan" android:textSize="9sp" android:textStyle="bold" />
    </LinearLayout>

    <!-- Zona central deliberadamente amplia, sin controles amontonados. -->
    <LinearLayout android:id="@+id/darklyz_center_stage" android:layout_width="0dp" android:layout_height="0dp" android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:orientation="vertical" android:gravity="center" android:padding="12dp" android:background="@android:color/transparent" app:layout_constraintStart_toEndOf="@id/darklyz_side_nav" app:layout_constraintEnd_toStartOf="@id/darklyz_game_panel" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent">
        <ImageView android:layout_width="72dp" android:layout_height="72dp" android:contentDescription="" android:src="@drawable/ic_darklyz_logo" android:scaleType="fitCenter" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="DARKLYZ" android:textColor="@color/darklyz_text" android:textSize="27sp" android:textStyle="bold" android:fontFamily="sans-serif-black" android:letterSpacing="0.08" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="MINECRAFT  ·  SIN LÍMITES" android:textColor="@color/darklyz_cyan" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.15" />
        <View android:layout_width="96dp" android:layout_height="1dp" android:layout_marginTop="17dp" android:layout_marginBottom="17dp" android:background="@color/darklyz_border" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:text="Tu próximo mundo empieza aquí." android:textColor="@color/darklyz_text_secondary" android:textSize="13sp" />
    </LinearLayout>

    <!-- Panel de instalación: compacto y fijo a la derecha. -->
    <LinearLayout android:id="@+id/darklyz_game_panel" android:layout_width="220dp" android:layout_height="0dp" android:layout_marginTop="4dp" android:layout_marginEnd="4dp" android:layout_marginBottom="4dp" android:orientation="vertical" android:padding="11dp" android:background="@drawable/darklyz_card" android:gravity="center_vertical" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CENTRO DE JUEGO" android:textColor="@color/darklyz_cyan" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.11" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_marginBottom="12dp" android:text="Preparado para jugar" android:textColor="@color/darklyz_text" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" android:text="VERSIÓN DE MINECRAFT" android:textColor="@color/darklyz_text_secondary" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.06" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <com.kdt.mcgui.mcVersionSpinner android:id="@+id/mc_version_spinner" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/darklyz_field" android:drawableEnd="@drawable/spinner_arrow" app:drawableEndSize="@dimen/padding_heavy" app:drawableStartIntegerScaling="true" app:drawableStartSize="@dimen/_36sdp" app:drawableEndPadding="@dimen/_1sdp"  android:popupBackground="@color/darklyz_surface_elevated"/>
            <ImageButton android:id="@+id/edit_profile_button" android:layout_width="42dp" android:layout_height="42dp" android:layout_marginStart="6dp" android:background="@drawable/darklyz_icon_button" android:contentDescription="Editar perfil y versión" android:src="@drawable/ic_edit_profile" android:tint="@color/darklyz_cyan" android:scaleType="fitCenter" android:padding="10dp" android:stateListAnimator="@animator/darklyz_button_state" />
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="7dp" android:text="Todo listo para iniciar" android:gravity="center" android:textColor="@color/darklyz_text_muted" android:textSize="10sp" />
        <com.kdt.mcgui.MineButton android:id="@+id/play_button" android:layout_width="match_parent" android:layout_height="52dp" android:background="@drawable/darklyz_button_primary" android:elevation="4dp" android:stateListAnimator="@animator/darklyz_button_state" android:text="@string/main_play" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
