<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:padding="18dp" android:orientation="vertical" android:background="@drawable/darklyz_card"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TU PRÓXIMO MUNDO" android:textColor="@color/darklyz_cyan" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.16"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Tu mundo empieza aquí" android:textColor="@color/darklyz_text" android:textSize="23sp" android:textStyle="bold" android:fontFamily="sans-serif-medium"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Gestiona tus versiones, prepara tus controles y entra a jugar." android:textColor="@color/darklyz_text_secondary" android:textSize="13sp" android:lineSpacingExtra="2dp"/></LinearLayout>
