<com.kdt.mcgui.LauncherMenuButton android:id="@+id/install_jar_button" style="@style/LauncherMenuButton.Universal" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginBottom="8dp" android:drawableStart="@drawable/ic_menu_install_jar" android:drawablePadding="12dp" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="12dp" android:text="@string/main_install_jar_file" android:textAllCaps="false" android:textSize="13sp" android:background="@drawable/darklyz_button_secondary" android:stateListAnimator="@animator/darklyz_button_state" android:elevation="2dp"/>
<com.kdt.mcgui.LauncherMenuButton android:id="@+id/share_logs_button" style="@style/LauncherMenuButton.Universal" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginBottom="8dp" android:drawableStart="@android:drawable/ic_menu_share" android:drawablePadding="12dp" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="12dp" android:text="@string/main_share_logs" android:textAllCaps="false" android:textSize="13sp" android:background="@drawable/darklyz_button_secondary" android:stateListAnimator="@animator/darklyz_button_state" android:elevation="2dp"/>
<com.kdt.mcgui.LauncherMenuButton android:id="@+id/open_files_button" style="@style/LauncherMenuButton.Universal" android:layout_width="match_parent" android:layout_height="54dp" android:drawableStart="@drawable/ic_folder" android:drawablePadding="12dp" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="12dp" android:text="@string/mcl_button_open_directory" android:textAllCaps="false" android:textSize="13sp" android:background="@drawable/darklyz_button_secondary" android:stateListAnimator="@animator/darklyz_button_state" android:elevation="2dp"/>
</LinearLayout></ScrollView>
<View android:id="@+id/_background_display_view" android:layout_width="match_parent" android:layout_height="0dp" android:background="@color/background_bottom_bar" android:translationZ="-1dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintTop_toTopOf="@id/mc_version_spinner"/>
<com.kdt.mcgui.mcVersionSpinner android:id="@+id/mc_version_spinner" android:layout_width="0dp" android:layout_height="@dimen/_52sdp" android:layout_marginStart="16dp" android:layout_marginEnd="8dp" android:layout_marginBottom="10dp" android:background="@drawable/darklyz_field" android:drawableEnd="@drawable/spinner_arrow" app:drawableEndSize="@dimen/padding_heavy" app:drawableStartIntegerScaling="true" app:drawableStartSize="@dimen/_36sdp" app:drawableEndPadding="@dimen/_1sdp" app:layout_constraintBottom_toTopOf="@id/play_button" app:layout_constraintEnd_toStartOf="@id/edit_profile_button" app:layout_constraintStart_toStartOf="parent" android:popupBackground="@color/darklyz_surface_elevated"/>
<ImageButton android:id="@+id/edit_profile_button" android:layout_width="@dimen/_52sdp" android:layout_height="@dimen/_52sdp" android:layout_marginEnd="16dp" android:background="@drawable/darklyz_icon_button" android:contentDescription="Editar perfil y versión" android:src="@drawable/ic_edit_profile" android:tint="@color/darklyz_cyan" android:scaleType="fitCenter" android:padding="12dp" app:layout_constraintBottom_toBottomOf="@id/mc_version_spinner" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="@id/mc_version_spinner" android:stateListAnimator="@animator/darklyz_button_state"/>
<com.kdt.mcgui.MineButton android:id="@+id/play_button" android:layout_width="match_parent" android:layout_height="@dimen/_62sdp" android:layout_marginStart="17dp" android:layout_marginEnd="17dp" android:layout_marginBottom="15dp" android:background="@drawable/darklyz_button_primary" android:elevation="4dp" android:stateListAnimator="@animator/darklyz_button_state" android:text="@string/main_play" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
